rules_version = '2';
// BEST (newcomer care) app — personal data of newcomers. Default deny; only ACTIVE staff can read/write BEST data.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return /databases/$(db)/documents/staff/$(request.auth.uid); }
    function isStaff() { return signedIn() && exists(me()) && get(me()).data.active == true; }
    function isAdmin() { return isStaff() && get(me()).data.role == 'admin'; }
    function s(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function isDate(v) { return v is string && (v == '' || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function od(d, k) { return !(k in d) || isDate(d[k]); }

    // Church key (the QR link carries it: /install.html?k=KEY). Nobody can read it from a client. Only an admin may replace it.
    match /config/{id} {
      allow read: if false;
      allow create, update: if id == 'invite' && isAdmin()
        && request.resource.data.keys().hasOnly(['code', 'updatedAt'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z0-9]{12,32}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // The church key a device presented when joining (write-only, never readable). Checked by the staff create rule below.
    // Devices sign in with Firebase Anonymous auth (one uid per install); the key - not the sign-in method - decides access.
    match /staffKeys/{uid} {
      allow read, delete: if false;
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string && request.resource.data.code.size() <= 32;
    }

    match /staff/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;   // own doc: lets the app know "joined / deactivated"
      allow read: if isStaff();
      // Join: only with the right church key, always as active plain staff (never admin).
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'active', 'role', 'joinedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.active == true && request.resource.data.role == 'staff'
        && request.resource.data.joinedAt == request.time
        && getAfter(/databases/$(db)/documents/staffKeys/$(uid)).data.code
           == get(/databases/$(db)/documents/config/invite).data.code;
      // Self: rename only. Admin: activate/deactivate someone else. Role changes only via console/REST.
      allow update: if (isStaff() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40)
        || (isAdmin() && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && request.resource.data.active is bool);
      allow delete: if false;
    }

    // phone / line: fields removed from the app (owner 2026-11-17). Never written by new data; an OLD value may stay untouched
    // (so old cards still save) or be removed, but cannot be added or changed. `old` = the stored doc on update, {} on create.
    function legacyOk(d, old) {
      return (!('phone' in d) || ('phone' in old && d.phone == old.phone)) && (!('line' in d) || ('line' in old && d.line == old.line));
    }
    function bestOk(d) {
      return d.keys().hasOnly(['name', 'nick', 'photo', 'gender', 'age', 'job', 'school', 'grade', 'phone', 'line', 'area', 'firstVisit', 'invitedBy',
          'faith', 'family', 'prayer', 'memo', 'caretaker', 'stage', 'stageHistory', 'cls', 'lastContact',
          'nextAction', 'nextDue', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && s(d, 'nick', 20) && s(d, 'photo', 300000) && s(d, 'gender', 10) && s(d, 'age', 10) && s(d, 'job', 40) && s(d, 'school', 40) && s(d, 'grade', 40)
        && s(d, 'area', 200) && s(d, 'invitedBy', 60) && s(d, 'faith', 20) && s(d, 'family', 1000)
        && s(d, 'prayer', 2000) && s(d, 'memo', 2000) && s(d, 'caretaker', 128) && s(d, 'nextAction', 300)
        && od(d, 'firstVisit') && od(d, 'lastContact') && od(d, 'nextDue')
        && d.stage in ['first', 'welcome', 'revisit', 'class', 'group', 'settled', 'paused', 'unreachable']
        && (!('stageHistory' in d) || (d.stageHistory is list && d.stageHistory.size() <= 200))
        && (!('cls' in d) || (d.cls is list && d.cls.size() == 5))
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }

    match /bests/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && bestOk(request.resource.data) && legacyOk(request.resource.data, {})
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if isStaff() && bestOk(request.resource.data) && legacyOk(request.resource.data, resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();

      match /logs/{lid} {
        function logOk(d) {
          return d.keys().hasOnly(['date', 'method', 'content', 'prayer', 'next', 'due', 'by', 'at'])
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.method in ['phone', 'line', 'visit', 'church', 'other']
            && s(d, 'content', 2000) && s(d, 'prayer', 2000) && s(d, 'next', 300) && od(d, 'due')
            && d.by is string;
        }
        allow read: if isStaff();
        allow create: if isStaff() && logOk(request.resource.data)
          && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
        allow update: if isStaff() && logOk(request.resource.data)
          && request.resource.data.by == resource.data.by && request.resource.data.at == resource.data.at;
        allow delete: if isAdmin() || (isStaff() && resource.data.by == request.auth.uid);
      }

      // Supplements ("보충 / 補充") under the memo: append-only notes. Author may delete own; admin may delete any. No edits.
      match /notes/{nid} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(['text', 'by', 'byName', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
          && request.resource.data.by == request.auth.uid
          && request.resource.data.byName is string && request.resource.data.byName.size() <= 40
          && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if isAdmin() || (isStaff() && resource.data.by == request.auth.uid);
      }
    }

    // One doc per Sunday (id = YYYY-MM-DD): ids of BEST present.
    match /attendance/{day} {
      allow read: if isStaff();
      allow create, update: if isStaff() && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['ids', 'updatedAt', 'by'])
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 500
        && request.resource.data.updatedAt == request.time && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /{other=**} { allow read, write: if false; }
  }
}
